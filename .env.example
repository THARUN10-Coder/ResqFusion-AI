# ==============================================================================
# ResQFusion AI - Environment Variables & External Data Connector Configuration
# ==============================================================================

# Database Configuration (Defaults to SQLite if omitted)
DATABASE_URL=sqlite:///./resqfusion.db
# For PostgreSQL with PostGIS:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resqfusion

# AI Engine Provider: "mock", "openai", or "gemini"
AI_PROVIDER=mock
AI_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
SECRET_KEY=resqfusion-super-secret-key-2026

# ==============================================================================
# REAL-WORLD DISASTER DATA CONNECTORS
# ==============================================================================

# 1. SACHET / NDMA (National Disaster Management Authority - India)
SACHET_ENABLED=true
SACHET_FEED_URL=https://sachet.ndma.gov.in/cap_feed.xml
SACHET_POLL_SECONDS=120

# 2. GDACS (Global Disaster Alert and Coordination System - UN / EC)
GDACS_ENABLED=true
GDACS_FEED_URL=https://www.gdacs.org/xml/rss.xml
GDACS_POLL_SECONDS=300

# 3. NASA FIRMS (Fire Information for Resource Management System)
# Register for free MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_ENABLED=true
FIRMS_MAP_KEY=
FIRMS_REGION=76,8,81,14
FIRMS_POLL_SECONDS=600

# 4. USGS (United States Geological Survey - Real-Time Earthquakes)
USGS_ENABLED=true
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
USGS_POLL_SECONDS=120
